{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sobre",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/depoimentos",
      "destination": "/#depoimentos",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/atuacao",
      "destination": "/atuacao/index.html"
    },
    {
      "source": "/atuacao/prisao-em-flagrante",
      "destination": "/atuacao/prisao-em-flagrante/index.html"
    },
    {
      "source": "/atuacao/habeas-corpus",
      "destination": "/atuacao/habeas-corpus/index.html"
    },
    {
      "source": "/atuacao/audiencia-de-custodia",
      "destination": "/atuacao/audiencia-de-custodia/index.html"
    },
    {
      "source": "/atuacao/inquerito-policial",
      "destination": "/atuacao/inquerito-policial/index.html"
    },
    {
      "source": "/atuacao/acao-penal",
      "destination": "/atuacao/acao-penal/index.html"
    },
    {
      "source": "/atuacao/tribunal-do-juri",
      "destination": "/atuacao/tribunal-do-juri/index.html"
    },
    {
      "source": "/informacao-importante",
      "destination": "/informacao-importante/index.html"
    },
    {
      "source": "/informacao-importante/prisao-preventiva",
      "destination": "/informacao-importante/prisao-preventiva/index.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade/index.html"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/termos-de-uso/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(404|403)\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/index-(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(webp|png|jpg|jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.woff2?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
